[Unit]
Description=PyxeeTB (Twitch chat bot)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pyxeetb
Environment="PATH=/home/ubuntu/pyxeetb/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONMALLOC=malloc"
# No EnvironmentFile= for .env on purpose. config.py already loads it via
# python-dotenv, so systemd reading it too was pure duplication — and the
# two parsers don't agree: systemd treats the whole unit as failed-to-start
# on a line it can't parse and handles quoting differently, so a .env that
# works fine when the bot is run by hand can make the service refuse to
# start with a message that points at systemd rather than at the file.
# Anything that genuinely must be in the unit's own environment belongs in
# an Environment= line above.
ExecStart=/home/ubuntu/pyxeetb/.venv/bin/python /home/ubuntu/pyxeetb/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
OOMScoreAdjust=-100
LimitNOFILE=65536

# Cgroup-level ceiling, independent of OOMScoreAdjust above (which only
# affects the *global* OOM-killer's priority, not what happens if this
# unit alone runs away) — protects the rest of a small box (Oracle Free
# Tier) from a stuck process.
# MemoryHigh throttles (reclaims memory, slows the process) before
# MemoryMax hits and the kernel OOM-kills it outright. Tune both to the
# box: these are conservative starting points, not a hard requirement —
# raise them if the service gets killed under normal (not runaway) load.
MemoryHigh=512M
MemoryMax=768M
CPUQuota=150%

MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
# Only data/ is writable — everything this process persists (the database, its
# backups, the OAuth tokens) lives there. Logs go to stdout, i.e. journald.
ReadWritePaths=/home/ubuntu/pyxeetb/data
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# New files (the database, its backups, the OAuth token file) are created
# private to the service user rather than world-readable.
UMask=0077
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
# Only the socket families this bot uses: IP to reach Twitch and serve the web
# UI, and Unix sockets for local name resolution.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
