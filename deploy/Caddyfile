__SITE_ADDRESS__ {
	encode zstd gzip

	header -Server

	request_body {
		max_size 1MB
	}

	# /settings: Caddy does the signing in (HTTP basic auth) and tells the bot
	# who it let through in X-Authenticated-User. The bot has no login of its
	# own and only believes that header from this machine (TWITCH_TRUSTED_PROXIES).
	@settings path /settings /settings/*
	handle @settings {
		basic_auth {
			__ADMIN_USER__ __ADMIN_HASH__
		}
		reverse_proxy __UPSTREAM__ {
			header_up X-Authenticated-User {http.auth.user.id}
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	# Everything else is public (/commands, /chat-overlay, /healthz ...). A
	# client-supplied X-Authenticated-User is stripped so it can never be forged.
	handle {
		reverse_proxy __UPSTREAM__ {
			header_up -X-Authenticated-User
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}
