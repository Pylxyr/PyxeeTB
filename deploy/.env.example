# ─────────────────────────────────────────────────────────────
# PyxeeTB. The four Twitch values below are required. Authorizing the
# bot account is a separate one-time step — see the README.
# ─────────────────────────────────────────────────────────────

# From https://dev.twitch.tv/console/apps — register an application there
# (OAuth Redirect URL: http://localhost:4343/oauth/callback), Client ID and
# a generated Client Secret both come from that app's page.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Numeric Twitch user IDs, not usernames — digits only, nothing else (not
# "Twitch ID:1536026185", just "1536026185" — Helix rejects that with a bare
# "Bad Identifiers" error that doesn't say which field is wrong; validated at
# startup with a clearer message than that). BOT_ID is the account the bot
# chats as (recommend a dedicated account, made a moderator in your
# channel); OWNER_ID is the broadcaster/channel the bot joins. Look either
# up from a username at
# https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

# Command prefix in Twitch chat
# TWITCH_PREFIX=!

# Feature toggles and tuning values are stored in the database, adjustable
# live with !toggle / !setlimit in chat or on the /settings page — nothing to
# set here.

# This service serves the chat overlay, the public /commands page, and the
# /settings dashboard over plain HTTP.
#
# Keep TWITCH_HTTP_HOST at 127.0.0.1. To reach it from another machine,
# put Caddy in front (deploy/setup.sh installs and configures it) rather than
# binding 0.0.0.0. Caddy also signs you in to /settings (basic_auth) — the bot
# has no login of its own. See the README's "Publishing with Caddy" section.
# TWITCH_HTTP_HOST=127.0.0.1
# TWITCH_HTTP_PORT=8098

# Reverse proxies whose X-Forwarded-For/-Proto/-Host and X-Authenticated-User
# headers are believed (comma-separated IPs or CIDR ranges). The default covers
# Caddy on this machine; only change it if the proxy runs somewhere else.
# TWITCH_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Where !commands / !help send viewers (the page is <base>/commands). Unset =
# the GitHub Pages sheet of built-in commands, https://pylxyr.github.io/PyxeeTB
# — rebuilt on every push to main, nothing to configure. Forks set their own
# Pages URL (or https://bot.example.com to use the bot's own /commands route).
# "none" turns the link off and uses the terse in-chat listing. Leave it
# unset for the default: a value here wins over it.
# TWITCH_PUBLIC_BASE_URL=

# Third-party chat-overlay emote providers (comma-separated): 7tv, bttv, ffz.
# Unset = all three. "none" = Twitch emotes and cheermotes only.
# TWITCH_EMOTE_PROVIDERS=7tv,bttv,ffz

# Cosmetic suffixes the bot rotates onto a message only when it would repeat
# one it just sent (Twitch silently drops exact repeats). Comma-separated;
# "none" turns it off. Unset = a small set of sparkle emoji.
# TWITCH_REPLY_SUFFIXES=

# Command names another bot in your channel already answers to, so mods can't
# define a custom command that would collide with it. Comma-separated.
# TWITCH_RESERVED_COMMANDS=

# How many daily database backups to keep (0 turns them off).
# TWITCH_DB_BACKUP_KEEP=7

# ─────────────────────────────────────────────────────────────
# Logging — to stdout; under systemd read it with `journalctl -u pyxeetb -f`
# ─────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
